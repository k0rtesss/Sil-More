  "acceptance_criteria": {
    "externs_header_lines": {
      "wave0_freeze_max": 1159,
      "finish_max": 400,
      "notes": "Wave 0 must stop growth immediately. Finish-line target is under 400 lines."
    },
    "extern_include_sites": {
      "wave0_freeze_max": 182,
      "finish_max": 25,
      "notes": "Wave 0 freezes direct include fan-out. Finish-line target is fewer than 25 direct include sites."
    },
    "variable_source_lines": {
      "wave0_freeze_max": 831,
      "finish_max": 200,
      "notes": "Wave 0 freezes the global-state bucket. Finish-line target is under 200 lines or full removal."
    },
    "root_src_c_files": {
      "wave0_freeze_max": 79,
      "finish_target": "root src/*.c limited to entrypoints, platform files, and explicit thin facades only",
      "notes": "Wave 0 stops growth of the root implementation bucket."
    },
    "root_src_h_files": {
      "wave0_freeze_max": 44,
      "finish_target": "root src/*.h limited to umbrella compatibility headers and true top-level interfaces",
      "notes": "Wave 0 records the transitional header surface."
    },
    "nonplatform_sdl_header_includes": {
      "wave0_freeze_max": 0,
      "finish_max": 0,
      "notes": "Finish-line target is zero SDL header imports outside the approved platform boundary."
    },
    "nonplatform_sdl_io_usages": {
      "wave0_freeze_max": 23,
      "finish_max": 0,
      "notes": "Finish-line target is zero SDL I/O usage outside the approved platform boundary."
    }
  },
