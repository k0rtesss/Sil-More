# Select SDK files from the target platform, never the build host.
# Kept separate so configuration checks can exercise every supported target.
function(sil_steamworks_sdk_files library_out implib_out)
  if(ANDROID OR SIL_IOS OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "SIL_STEAMWORKS supports desktop Windows, Linux and macOS only.")
  endif()
  if(NOT SIL_STEAM_APP_ID MATCHES "^[1-9][0-9]*$" OR SIL_STEAM_APP_ID GREATER 4294967295)
    message(FATAL_ERROR "SIL_STEAM_APP_ID must be a positive 32-bit Steam App ID.")
  endif()

  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
  set(implib "")
  if(WIN32)
    if(NOT processor MATCHES "^(amd64|x86_64|x64|x86|i[3-6]86)$")
      message(FATAL_ERROR "Steamworks Windows SDK requires an x86 or x86-64 target, got '${processor}'.")
    endif()
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
      set(api "win64/steam_api64")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
      set(api "steam_api")
    else()
      message(FATAL_ERROR "Unsupported Windows Steamworks pointer size: ${CMAKE_SIZEOF_VOID_P}")
    endif()
    set(library "${STEAMWORKS_SDK_ROOT}/redistributable_bin/${api}.dll")
    set(implib "${STEAMWORKS_SDK_ROOT}/redistributable_bin/${api}.lib")
  elseif(APPLE AND CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
      message(FATAL_ERROR "Steamworks macOS SDK requires a 64-bit target.")
    endif()
    set(architectures "${CMAKE_OSX_ARCHITECTURES}")
    if(NOT architectures)
      set(architectures "${processor}")
    endif()
    foreach(architecture IN LISTS architectures)
      if(NOT architecture MATCHES "^(x86_64|arm64)$")
        message(FATAL_ERROR "Unsupported macOS Steamworks architecture: ${architecture}")
      endif()
    endforeach()
    # The SDK dylib is universal: Intel x86-64 and Apple Silicon arm64.
    set(library "${STEAMWORKS_SDK_ROOT}/redistributable_bin/osx/libsteam_api.dylib")
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(processor MATCHES "^(aarch64|arm64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
      set(api linuxarm64)
    elseif(processor MATCHES "^(x86_64|amd64|x64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
      set(api linux64)
    elseif(processor MATCHES "^(x86|i[3-6]86|x86_64|amd64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 4)
      set(api linux32)
    else()
      message(FATAL_ERROR "Unsupported Linux Steamworks architecture: ${processor}, ${CMAKE_SIZEOF_VOID_P}-byte pointers")
    endif()
    set(library "${STEAMWORKS_SDK_ROOT}/redistributable_bin/${api}/libsteam_api.so")
  else()
    message(FATAL_ERROR "Unsupported Steamworks desktop platform: ${CMAKE_SYSTEM_NAME}")
  endif()

  foreach(sdk_file "${STEAMWORKS_SDK_ROOT}/public/steam/steam_api.h" "${library}" ${implib})
    if(NOT EXISTS "${sdk_file}")
      message(FATAL_ERROR "Missing Steamworks SDK file: ${sdk_file}. Extract the SDK under external/steamworks_sdk/ or set STEAMWORKS_SDK_ROOT.")
    endif()
  endforeach()
  set(${library_out} "${library}" PARENT_SCOPE)
  set(${implib_out} "${implib}" PARENT_SCOPE)
endfunction()

function(sil_target_steamworks target)
  sil_steamworks_sdk_files(api_library api_implib)
  add_library(Steamworks::SteamAPI SHARED IMPORTED)
  set_target_properties(Steamworks::SteamAPI PROPERTIES
    IMPORTED_LOCATION "${api_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${STEAMWORKS_SDK_ROOT}/public")
  if(api_implib)
    set_target_properties(Steamworks::SteamAPI PROPERTIES IMPORTED_IMPLIB "${api_implib}")
  endif()
  target_sources(${target} PRIVATE
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/steamworks.cpp"
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/achievements-steam.cpp")
  target_compile_features(${target} PRIVATE cxx_std_11)
  target_compile_definitions(${target} PRIVATE SIL_STEAMWORKS SIL_STEAM_APP_ID=${SIL_STEAM_APP_ID})
  target_link_libraries(${target} PRIVATE Steamworks::SteamAPI)

  # Ship the SDK runtime beside the executable. Find it after relocation too.
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "$ORIGIN")
    set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
  elseif(APPLE)
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "@executable_path")
    set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH "@executable_path")
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "$<TARGET_FILE:Steamworks::SteamAPI>" "$<TARGET_FILE_DIR:${target}>"
    VERBATIM)
  message(STATUS "Steamworks ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR} for App ID ${SIL_STEAM_APP_ID}: ${api_library}")
endfunction()
