# Used by the native Linux package helper through CMAKE_PROJECT_TOP_LEVEL_INCLUDES.
# Keep the vendored target's flags, headers and features, while compiling the
# same upstream amalgamation inputs separately so Ninja can use every core.
function(sil_split_harfbuzz)
  if(NOT TARGET harfbuzz)
    return()
  endif()
  get_target_property(original_sources harfbuzz SOURCES)
  set(sources)
  set(split_count 0)
  foreach(source IN LISTS original_sources)
    if(source MATCHES "(^|/)harfbuzz\\.cc$")
      get_filename_component(source_dir "${source}" DIRECTORY)
      file(STRINGS "${source}" includes REGEX "^#include \"[^\"]+\\.cc\"$")
      foreach(include IN LISTS includes)
        string(REGEX REPLACE "^#include \"([^\"]+)\"$" "\\1" filename "${include}")
        if(NOT EXISTS "${source_dir}/${filename}")
          message(FATAL_ERROR "Missing HarfBuzz amalgamation input: ${filename}")
        endif()
        list(APPEND sources "${source_dir}/${filename}")
        math(EXPR split_count "${split_count} + 1")
      endforeach()
      if(split_count EQUAL 0)
        message(FATAL_ERROR "No source inputs found in HarfBuzz amalgamation")
      endif()
    else()
      list(APPEND sources "${source}")
    endif()
  endforeach()
  set_property(TARGET harfbuzz PROPERTY SOURCES "${sources}")
  message(STATUS "HarfBuzz: compiling ${split_count} source files separately")
endfunction()

cmake_language(DEFER CALL sil_split_harfbuzz)
