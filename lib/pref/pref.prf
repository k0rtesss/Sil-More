#C:3:m

# Sing
A:s
C:3:a

# Character Sheet
A:@
C:3:C

# Options
A:O
C:3:=

# Interact with a square
A:/
C:3:+

# Set Macros
A:$
C:3:@

# Repeat as '0' is handled internally

# Remove some now unneeded commands (by assigning them to the unused 'A')
A:A
C:3:x
A:A
C:3:r
A:A
C:3:Z
A:A
C:3:O
A:A
C:3:/
A:A
C:3:^t

